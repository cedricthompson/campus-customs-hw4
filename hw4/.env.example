# Copy this file to .env (in this hw4/ folder) and fill in the values.
# Never commit .env; it is git-ignored.

# Portkey API key from your Portkey dashboard (used to reach the OpenAI model)
PORTKEY_API_KEY=your-portkey-api-key-here

# OpenAI model routed through Portkey
OPENAI_MODEL=gpt-6-luna

# Long random string that signs login cookies so logins survive restarts.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-with-a-long-random-string
